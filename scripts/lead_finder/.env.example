# Reddit API credentials — reuse the same app/account already set up in
# ~/repos/swing-analyzer/.env, no need to register a second Reddit app.
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=teesignal-lead-finder/1.0 (by /u/your_reddit_username)

# Only needed for --post (posting comments as your account). Must match the
# account that owns the app above; that app must be type "script", and 2FA
# must be off on the account or the password grant fails with invalid_grant.
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
